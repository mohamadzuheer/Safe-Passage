# ==============================================================================
# ReliefRoute / SafePassage Backend Environment Configuration Example
# ==============================================================================

# Core Application Environment
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Database & Cache (Matches docker-compose.yml local port mappings)
# Windows docker-compose binds PostgreSQL to host port 55432 and Redis to 6380
DATABASE_URL=postgresql://reliefroute:reliefroute@localhost:55432/reliefroute
REDIS_URL=redis://localhost:6380/0

# Routing Engine (Valhalla running on docker-compose)
VALHALLA_URL=http://localhost:8002

# Geographic Region Configuration (Andhra Pradesh)
REGION_BBOX=76.6,12.5,84.9,20.1
REGION_NAME=Andhra Pradesh

# LLM Reasoning Engine (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=

# Operational Security Tokens (Leave commented to let stack.ps1 generate, or specify)
# OPERATOR_TOKEN=
# ENROLMENT_CODE=

# Optional Integrations
# FIRMS_MAP_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# DRILL_SEND_MESSAGES=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

